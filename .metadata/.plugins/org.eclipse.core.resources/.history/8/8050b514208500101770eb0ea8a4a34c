<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>MediBridge : Comment Page</title>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    .main-content {
        padding: 20px;
        margin-top: 0;
    }

    .container {
        max-width: 700px;
        margin: 30px auto;
        background: white;
        border-radius: 15px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        animation: slideIn 0.8s ease-out;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 25px;
        text-align: center;
        position: relative;
    }

    .form-header h2 {
        font-size: 28px;
        font-weight: 300;
        letter-spacing: 1px;
    }

    .form-body {
        padding: 20px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group {
        flex: 1;
    }

    .form-group.full-width {
        flex: 2;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #555;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    input[type="text"],
    input[type="number"],
    input[type="tel"],
    textarea,
    select {
        width: 100%;
        padding: 15px;
        border: 2px solid #e1e5e9;
        border-radius: 8px;
        font-size: 16px;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    input[type="tel"]:focus,
    textarea:focus,
    select:focus {
        outline: none;
        border-color: #4facfe;
        background: white;
        box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.1);
        transform: translateY(-1px);
    }

    textarea {
        min-height: 120px;
        resize: vertical;
        font-family: inherit;
    }

    select {
        cursor: pointer;
    }

    .submit-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: block;
        margin: 30px auto 0;
        min-width: 150px;
        position: relative;
        overflow: hidden;
    }

    .submit-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s;
    }

    .submit-btn:hover::before {
        left: 100%;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    /* Icon styling */
    .form-header::after {
        content: '👨‍⚕️';
        position: absolute;
        top: -10px;
        right: 20px;
        font-size: 60px;
        opacity: 0.2;
    }

    /* Responsive design */
    @media (max-width: 768px) {
        .container {
            margin: 20px auto;
            border-radius: 0;
        }
        
        .form-row {
            flex-direction: column;
            gap: 0;
        }
        
        .form-body {
            padding: 20px;
        }
        
        .form-header h2 {
            font-size: 24px;
        }
    }

    /* Custom styling for better visual hierarchy */
    .priority-field {
        border-left: 4px solid #4facfe;
        padding-left: 16px !important;
    }

    .disease-field {
        border-left: 4px solid #ff6b6b;
        padding-left: 16px !important;
    }
</style>
</head>
<body>
<%@ include file="navbar_doctor.jsp" %>

<div class="main-content">
    <div class="container">
    <div class="form-header">
        <h2>Patient Assessment Form</h2>
    </div>
    
    <div class="form-body">
        <form action="submitComment" method="post">
            <div class="form-row">
                <div class="form-group">
                    <label for="patientName">Patient Name</label>
                    <input type="text" id="patientName" name="patientName" 
                           class="priority-field" placeholder="Enter patient's full name" required>
                </div>
                
                <div class="form-group">
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" 
                           min="1" max="120" placeholder="Age" required>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="mobile">Mobile Number</label>
                    <input type="tel" id="mobile" name="mobile" 
                           pattern="[0-9]{10}" placeholder="10-digit mobile number" required>
                </div>
                
                <div class="form-group">
                    <label for="disease">Primary Condition</label>
                    <select id="disease" name="disease" class="disease-field" required>
                        <option value="">Select condition</option>
                        <option value="liver">Liver Disease</option>
                        <option value="heart">Heart Disease</option>
                        <option value="kidney">Kidney Disease</option>
                        <option value="diabetes">Diabetes</option>
                        <option value="hypertension">Hypertension</option>
                        <option value="respiratory">Respiratory Issues</option>
                        <option value="neurological">Neurological Disorders</option>
                        <option value="orthopedic">Orthopedic Issues</option>
                        <option value="other">Other</option>
                    </select>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group full-width">
                    <label for="comment">Medical Notes & Observations</label>
                    <textarea id="comment" name="comment" 
                              placeholder="Enter detailed medical observations, treatment notes, patient symptoms, recommended medications, follow-up instructions, etc." 
                              required></textarea>
                </div>
            </div>
            
            <button type="submit" class="submit-btn">
                Submit Assessment
            </button>
        </form>
    </div>
</div>

</div>

</body>
</html>