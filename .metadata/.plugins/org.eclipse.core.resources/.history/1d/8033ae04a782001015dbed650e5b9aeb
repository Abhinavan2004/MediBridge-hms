package com.Doctor.servlet;

import java.io.IOException;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import com.DAO.DoctorDao;
import com.db.DBConnect;
import com.entity.Doctor_entity;

@WebServlet("/doctorLogin")
public class Doctor_Login extends HttpServlet {
    
    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse resp) 
            throws ServletException, IOException {
        
        System.out.println("=== DOCTOR LOGIN DEBUG ===");
        
        try {
            String email = req.getParameter("doc_email");
            String password = req.getParameter("doc_password");
            
            System.out.println("Received email: " + email);
            System.out.println("Received password: " + (password != null ? "[" + password.length() + " chars]" : "null"));
            
            HttpSession session = req.getSession();
            session.removeAttribute("errorMsg");
            session.removeAttribute("successMsg");
            
            // Validate input
            if (email == null || email.trim().isEmpty() || 
                password == null || password.trim().isEmpty()) {
                System.out.println("ERROR: Empty email or password");
                session.setAttribute("errorMsg", "Email and Password are required");
                resp.sendRedirect("Doctor.jsp");
                return;
            }
            
            // Test database connection
            System.out.println("Testing database connection...");
            try {
                if (DBConnect.getConn() != null) {
                    System.out.println("✓ Database connection successful");
                } else {
                    System.out.println("✗ Database connection is NULL");
                    session.setAttribute("errorMsg", "Database connection failed");
                    resp.sendRedirect("Doctor.jsp");
                    return;
                }
            } catch (Exception e) {
                System.out.println("✗ Database connection error: " + e.getMessage());
                e.printStackTrace();
                session.setAttribute("errorMsg", "Database connection error: " + e.getMessage());
                resp.sendRedirect("Doctor.jsp");
                return;
            }
            
            // Try login
            System.out.println("Attempting login with email: " + email);
            DoctorDao dao = new DoctorDao(DBConnect.getConn());
            Doctor_entity doctor = dao.Doctor_Login(email.trim(), password);
            
            if (doctor != null) {
                System.out.println("✓ Login successful for: " + doctor.getDoc_name());
                System.out.println("  - Doctor ID: " + doctor.getId());
                System.out.println("  - Doctor Email: " + doctor.getDoc_email());
                System.out.println("  - Doctor Specialization: " + doctor.getDoc_spec());
                
                session.setAttribute("doctObj", doctor);
                resp.sendRedirect("Doctor/Dashboard.jsp");
            } else {
                System.out.println("✗ Login failed for email: " + email);
                System.out.println("  - Check if email exists in database");
                System.out.println("  - Check if password matches");
                
                session.setAttribute("errorMsg", "Invalid Email or Password");
                resp.sendRedirect("Doctor.jsp");
            }
            
        } catch (Exception e) {
            System.out.println("✗ Exception in servlet: " + e.getMessage());
            e.printStackTrace();
            HttpSession session = req.getSession();
            session.setAttribute("errorMsg", "Login error: " + e.getMessage());
            resp.sendRedirect("Doctor.jsp");
        }
        
        System.out.println("=== END DEBUG ===");
    }
}