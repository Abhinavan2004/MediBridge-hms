package com.DAO;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

import com.entity.Message_entity;

public class MessageDao {
private Connection conn ;

public MessageDao(Connection conn) {
	super();
	this.conn = conn;
}

public List<Message_entity> getMessage(){
	List<Message_entity> list = new ArrayList<Message_entity>() ;
	Message_entity m = null ;
	
	try {
		String sql = "SELECT * FROM contact_msg";
		PreparedStatement ps = conn.prepareStatement(sql);
		ResultSet rs = ps.executeQuery();
		while(rs.next()) {
			m.setId(rs.getInt("id")) ;
			m.setName(rs.getString("name"));
			m.setEmail(rs.getString("email"));
			m.setSubject(rs.getString("subject"));
			m.setMessage(rs.getString("message"));
			m.setStatus(((Object) rs).MessageStatus("status"));
			list.add(m);			
		}
	}
	catch(Exception e) {
		e.printStackTrace() ;
	}
	return list ;
}
}
