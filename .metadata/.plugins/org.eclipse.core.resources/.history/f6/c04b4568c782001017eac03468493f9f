package com.Doctor.servlet;
import java.io.IOException;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import com.DAO.DoctorDao;
import com.db.DBConnect;
import com.entity.Doctor_entity;

@WebServlet("/doctorLogin")
public class Doctor_Login extends HttpServlet {
    @Override
    protected void doPost(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {
        
        // Debug: Print all parameters
        System.out.println("=== DEBUG: All Parameters ===");
        req.getParameterMap().forEach((key, value) -> {
            System.out.println("Parameter: " + key + " = " + String.join(",", value));
        });
        
        String email = req.getParameter("doc_email");
        String password = req.getParameter("doc_password");
        
        // Debug: Print extracted values
        System.out.println("=== DEBUG: Extracted Values ===");
        System.out.println("Email: " + email);
        System.out.println("Password: " + (password != null ? "*****" : "null"));
        
        HttpSession session = req.getSession();
        
        try {
            DoctorDao dao = new DoctorDao(DBConnect.getConn());
            System.out.println("=== DEBUG: Database Connection ===");
            System.out.println("Connection: " + (DBConnect.getConn() != null ? "Success" : "Failed"));
            
            Doctor_entity doctor = dao.Doctor_Login(email, password);
            System.out.println("=== DEBUG: Login Result ===");
            System.out.println("Doctor object: " + (doctor != null ? "Found" : "Not found"));
            
            if(doctor != null) {
                session.setAttribute("doctObj", doctor);
                resp.sendRedirect("Doctor/Dashboard.jsp");
                System.out.println("Doctor Logged in - Redirecting to dashboard");
            } else {
                session.setAttribute("errorMsg", "Invalid Email or Password");
                resp.sendRedirect("Doctor.jsp");
                System.out.println("Doctor Not Logged in - Redirecting back to login");
            }
        } catch (Exception e) {
            System.out.println("=== DEBUG: Exception ===");
            e.printStackTrace();
            session.setAttribute("errorMsg", "System error occurred");
            resp.sendRedirect("Doctor.jsp");
        }
    }
}