	private int id ;
	private int userid ;
	 private String app_name ;
	 private String App_gender ;
	 private int App_age ;
	 private String App_date ;
	 private String App_email ;
	 private String App_contact ;
	 private String App_cond;
	 private String App_add ;
	 private int doct_id ;
