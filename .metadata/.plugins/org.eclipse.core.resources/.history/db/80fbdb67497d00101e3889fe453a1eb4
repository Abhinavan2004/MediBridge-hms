package com.entity;

public class Specialist {
	String spec_name ;
	int id ;
	
	public Specialist(String spec_name, int id) {
		super();
		this.spec_name = spec_name;
		this.id = id;
	}
	
	public String getSpec_name() {
		return spec_name;
	}
	public void setSpec_name(String spec_name) {
		this.spec_name = spec_name;
	}
	public int getId() {
		return id;
	}
	public void setId(int id) {
		this.id = id;
	}
	
	
}
