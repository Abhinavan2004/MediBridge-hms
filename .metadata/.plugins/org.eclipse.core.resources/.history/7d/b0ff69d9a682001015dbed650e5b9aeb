    public Doctor_entity Doctor_Login(String email, String password) {
        System.out.println("--- DoctorDao.Doctor_Login ---");
        System.out.println("Searching for email: " + email);
        System.out.println("Password provided: " + (password != null && !password.isEmpty() ? "YES" : "NO"));
        
        Doctor_entity d = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        
        try {
            // First, let's check if the table exists and has data
            String countSql = "SELECT COUNT(*) FROM Doctor_record";
            PreparedStatement countPs = conn.prepareStatement(countSql);
            ResultSet countRs = countPs.executeQuery();
            
            if (countRs.next()) {
                int totalDoctors = countRs.getInt(1);
                System.out.println("Total doctors in database: " + totalDoctors);
            }
            countRs.close();
            countPs.close();
            
            // Check if email exists
            String emailCheckSql = "SELECT COUNT(*) FROM Doctor_record WHERE doc_email=?";
            PreparedStatement emailPs = conn.prepareStatement(emailCheckSql);
            emailPs.setString(1, email);
            ResultSet emailRs = emailPs.executeQuery();
            
            if (emailRs.next()) {
                int emailCount = emailRs.getInt(1);
                System.out.println("Doctors with email '" + email + "': " + emailCount);
            }
            emailRs.close();
            emailPs.close();
            
            // Now try the actual login query
            String sql = "SELECT * FROM Doctor_record WHERE doc_email=? AND doc_password=?";
            System.out.println("Executing query: " + sql);
            
            ps = conn.prepareStatement(sql);
            ps.setString(1, email);
            ps.setString(2, password);
            
            System.out.println("Query parameters set - executing...");
            rs = ps.executeQuery();
            
            if (rs.next()) {
                System.out.println("✓ Found matching doctor record!");
                d = new Doctor_entity();
                d.setId(rs.getInt("id"));
                d.setDoc_name(rs.getString("doc_name"));
                d.setDoc_dob(rs.getString("doc_dob"));
                d.setDoc_quali(rs.getString("doc_quali"));
                d.setDoc_spec(rs.getString("doc_spec"));
                d.setDoc_email(rs.getString("doc_email"));
                d.setDoc_contact(rs.getString("contact_no"));
                d.setDoc_password(rs.getString("doc_password"));
                
                System.out.println("Doctor loaded: " + d.getDoc_name());
            } else {
                System.out.println("✗ No matching doctor record found");
                
                // Let's check what passwords are in the database for this email
                String passwordCheckSql = "SELECT doc_password FROM Doctor_record WHERE doc_email=?";
                PreparedStatement pwPs = conn.prepareStatement(passwordCheckSql);
                pwPs.setString(1, email);
                ResultSet pwRs = pwPs.executeQuery();
                
                if (pwRs.next()) {
                    String dbPassword = pwRs.getString("doc_password");
                    System.out.println("Email exists, but password mismatch:");
                    System.out.println("  - Provided password: '" + password + "'");
                    System.out.println("  - Database password: '" + dbPassword + "'");
                    System.out.println("  - Passwords equal? " + password.equals(dbPassword));
                } else {
                    System.out.println("Email '" + email + "' not found in database");
                }
                pwRs.close();
                pwPs.close();
            }
            
        } catch (Exception e) {
            System.out.println("✗ Exception in Doctor_Login: " + e.getMessage());
            e.printStackTrace();
        } finally {
            try {
                if (rs != null) rs.close();
                if (ps != null) ps.close();
            } catch (Exception e) {
                e.printStackTrace();
            }
        }
        
        System.out.println("--- End DoctorDao.Doctor_Login ---");
        return d;
    }
